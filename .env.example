# ==============================================================================
# Hoppa Workspace & Apps Environment Template (SAFE PLACEHOLDERS ONLY)
# Copy to .env for local development. Never commit real .env secrets to Git.
# ==============================================================================

# --- Mobile Development (.env loaded only when !kReleaseMode) ---
LOCAL_IP=127.0.0.1
API_URL=http://127.0.0.1:3000
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Backend API (backend/.env or Cloud Env Vars) ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/hoppa?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/hoppa?schema=public
PUBLIC_BASE_URL=https://api.hoppanow.com
CORS_ALLOWED_ORIGINS=https://hoppanow.com,https://www.hoppanow.com

# Strong random >= 32-byte secrets required in production / LIVE mode
JWT_SECRET=replace_with_at_least_32_byte_random_production_jwt_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_byte_random_refresh_secret
PAYMENT_CALLBACK_SECRET=replace_with_at_least_32_byte_random_payment_hmac_secret

# Payment Routing ('LIVE' default in production, 'SANDBOX' for local test)
PAYMENT_PROVIDER_MODE=SANDBOX
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
CARDPLUS_MERCHANT_ID=
CARDPLUS_STORE_KEY=
CARDPLUS_API_URL=

# Media (Cloudflare R2 required in production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
PUBLIC_CDN_URL=

# AI & Messaging
GEMINI_API_KEY=
SMS_PROVIDER_MODE=SANDBOX
ALLOW_STORE_REVIEW_TEST_ACCOUNTS=false
TEST_PHONE_NUMBERS=
TEST_OTP_CODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
